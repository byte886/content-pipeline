# ============================================================
# .gitignore — 本仓库「不入库产物」清单
# 原则：Git只放代码+文档+配置；视频/转写稿/文章正文等大文件不入库
# ============================================================

# --- 操作系统 / 编辑器 ---
.DS_Store
.vscode/
.idea/
*.swp
*.swo

# --- 依赖与虚拟环境 ---
node_modules/
venv/
.venv/
env/
__pycache__/
*.pyc
*.pyo
*.egg-info/

# --- 环境变量与密钥（整个 .secrets/ 一律不入库，含 .enc 加密件；凭证仅本地持有，见 ADR-003/ISSUE-014）---
.env
.secrets/
*.pem
*.key

# --- 视频/音频/转写产物（大文件，走网盘不入库）---
*.mp4
*.mp3
*.wav
*.m4a
*.aac
*.flv
*.ts
*.m3u8
segments/

# --- 文档原件（成品走网盘，不入库）---
*.pdf
*.doc
*.docx
*.ppt
*.pptx
*.xls
*.xlsx

# --- 图片（文章配图走网盘，不入库）---
*.jpg
*.jpeg
*.png
*.gif
*.webp
*.bmp

# --- 数据目录（整体不入库：原料+成品+过程件）---
data/
knowledge-base/

# --- library/ 下的原料目录（不入库，仅05_knowledge的stable成品入库）---
library/01_video/
library/02_audio/
library/04_transcript/
library/06_articles/
library/07_books/
library/08_sources/*/raw/
library/08_sources/*/cleaned/

# 例外：01_video 虽整体忽略，但逐级“放行目录”，并对来源目录内容采用白名单，
# 只让台账清单与说明入库，媒体与运行时缓存仍忽略。
# git 规则：父目录被忽略后其中文件无法单独取反，必须逐级把目录本身取反。
!library/01_video/
!library/01_video/*/
!library/01_video/*/*/
!library/01_video/README.md
# 来源账号目录下先默认忽略其全部条目（含子目录、时长缓存、签名清单等过程件）…
library/01_video/*/*/*
# …再只取反台账与说明（白名单）；*.mp4/*.wav/*.jpg 等媒体另由上方全局规则忽略
!library/01_video/*/*/manifest.json
!library/01_video/*/*/manifest.csv
!library/01_video/*/*/README.md
!library/06_articles/*/*/manifest.json
!library/07_books/*/manifest.json

# --- 运行时工作区（过程件，不入库不传网盘）---
workspace/*
!workspace/README.md
_workspace/

# --- 日志 ---
logs/
*.log

# --- 临时 / 备份 / 合并冲突 ---
*.tmp
*.temp
*.bak
*.orig

# --- 本地配置 ---
config.local.json
