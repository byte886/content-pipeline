# 编译产物
video-capture
*.exe

# CA证书和私钥
ca.crt
ca.key

# 视频输出
videos.json
downloads/

# 测试文件
test_*.json

# --- 运行时捕获产物（含临时签名票据 token/sign/svrbypass/svrnonce，禁止入 public 仓）---
# 抓包原始落库：换签直链、decode_key、签名 URL 都在里面
capture_*.json
capture_*.log
run_*.out
run_*.log
*.pid

# 含完整签名直链的清单/台账（回放换签 URL 带 sign/svrbypass/svrnonce）
shorts_*_slim.json
replays_*_slim.json
replays_*_manifest.json
*_manifest_signed.json

# 放行：脱敏后的台账（去掉签名 URL，仅保留 oid/标题/时长/size/md5/encfilekey 等元数据）
!catalog_*.json
!registry_*.json

# 全量换签直链合集（短视频+回放，含临时 token/sign，禁止入 public 仓）
finder_*_manifest.json
*_full_manifest.json

# --- 公众号链接枚举探查过程产物（含抓取数据/凭证，禁止入 public 仓）---
mp_articles.json
mp_articles_*/
mp_profile_clean.json
test_getmsg.py
