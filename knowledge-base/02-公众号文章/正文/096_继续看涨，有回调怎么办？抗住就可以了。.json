n data-pm-slice='1 1 [\"para\",null]' leaf=\"\"><span style=\"font-weight: bold;\" textstyle=\"\">除非再出现普涨大阳线，才考虑适当减仓。</span></span></section></section><p style=\"display: none;\"><mp-style-type data-value=\"3\"></mp-style-type></p></div>",
