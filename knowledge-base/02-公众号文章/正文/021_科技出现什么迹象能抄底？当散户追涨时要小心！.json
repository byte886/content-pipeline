img\" data-aistatus=\"1\" data-imgfileid=\"100003348\" data-ratio=\"0.516728624535316\" data-s=\"300,640\" data-src=\"https://mmbiz.qpic.cn/sz_mmbiz_png/Bgib4dvhgGgxMAXEwF6nUrooBs6Jk2gCHMwtN3ia8iaOj1JvwKj0icxFG1qpplLU66ljvHMdA2UunUv8ibl1QVAcIrEjNjTthFROGd9LEL1JSiamQ/640?wx_fmt=png&amp;from=appmsg\" data-type=\"png\" data-w=\"807\" type=\"block\"/></section><p style=\"text-align: justify;text-indent: 2em;\"><span style=\"color: rgb(63, 63, 63);font-size: 10pt;\"><font face=\"等线(中文正文)\"><span leaf=\"\"><span style=\"font-size: 17px;font-weight: bold;\" textstyle=\"\">这波上涨有几个迹象</span></span></font></span><span style=\"color: rgb(63, 63, 63);font-size: 10pt;\"><font face=\"等线(中文正文)\"><span leaf=\"\"><span style=\"font-size: 17px;font-weight: bold;\" textstyle=\"\">：</span></span></font></span></p><p style=\"text-align: justify;text-indent: 2em;\"><span style=\"color: rgb(63, 63, 63);font-size: 10pt;\"><font face=\"等线(中文正文)\"><span leaf=\"\"><span style=\"font-size: 17px;font-weight: bold;\" textstyle=\"\">一个是老登尤其是红利加速下跌</span></span></font></span><span style=\"color: rgb(63, 63, 63);font-size: 10pt;\"><font face=\"等线(中文正文)\"><span leaf=\"\"><span style=\"font-size: 17px;font-weight: bold;\" textstyle=\"\">。</span></span></font></span></p><p style=\"text-align: justify;text-indent: 2em;\"><span style=\"color: rgb(63, 63, 63);font-size: 10pt;\"><font face=\"等线(中文正文)\"><span leaf=\"\"><span style=\"font-size: 17px;font-weight: bold;\" textstyle=\"\">第二个是科技的没缩量</span></span></font></span><span style=\"color: rgb(63, 63, 63);font-size: 10pt;\"><font face=\"等线(中文正文)\"><span leaf=\"\"><span style=\"font-size: 17px;font-weight: bold;\" textstyle=\"\">，</span></span></font></span><span style=\"color: rgb(63, 63, 63);font-size: 10pt;\"><font face=\"等线(中文正文)\"><span leaf=\"\"><span style=\"font-size: 17px;font-weight: bold;\" textstyle=\"\">没有充分消化前面的套牢盘</span></span></font></span><span style=\"color: rgb(63, 63, 63);font-size: 10pt;\"><font face=\"等线(中文正文)\"><span leaf=\"\"><span style=\"font-size: 17px;font-weight: bold;\" textstyle=\"\">。</span></span></font></span></p><p style=\"text-align: justify;text-indent: 2em;\"><span style=\"color: rgb(63, 63, 63);font-size: 10pt;\"><font face=\"等线(中文正文)\"><span leaf=\"\"><span style=\"font-size: 17px;font-weight: bold;\" textstyle=\"\">而且这波拉升是完全无视美股韩股。</span></span></font></span></p><p style=\"text-align: justify;text-indent: 2em;\"><span style=\"color: rgb(63, 63, 63);font-size: 10pt;\"><font face=\"等线(中文正文)\"><span leaf=\"\"><span style=\"font-size: 17px;font-weight: bold;\" textstyle=\"\">美股韩股是一直在震荡，同时老登是</span></span></font></span><span style=\"color: rgb(63, 63, 63);font-size: 10pt;\"><font face=\"等线(中文正文)\"><span leaf=\"\"><span style=\"font-size: 17px;font-weight: bold;\" textstyle=\"\">底部反弹。</span></span></font></span></p><p style=\"text-align: justify;text-indent: 2em;\"><span style=\"color: rgb(63, 63, 63);font-size: 10pt;\"><font face=\"等线(中文正文)\"><span leaf=\"\"><span style=\"font-size: 17px;font-weight: bold;\" textstyle=\"\">但</span></span></font></span><span style=\"color: rgb(63, 63, 63);font-size: 10pt;\"><font face=\"等线(中文正文)\"><span leaf=\"\"><span style=\"font-size: 17px;font-weight: bold;\" textstyle=\"\">A股</span></span></font></span><span style=\"color: rgb(63, 63, 63);font-size: 10pt;\"><font face=\"等线(中文正文)\"><span leaf=\"\"><span style=\"font-size: 17px;font-weight: bold;\" textstyle=\"\">根本无视，就</span></span></font></span><span style=\"color: rgb(63, 63, 63);font-size: 10pt;\"><font face=\"等线(中文正文)\"><span leaf=\"\"><span style=\"font-size: 17px;font-weight: bold;\" textstyle=\"\">是无脑拉科技。</span></span></font></span></p><section nodeleaf=\"\" style=\"text-align: center;\"><img class=\"rich_pages wxw-img\" data-aistatus=\"1\" data-imgfileid=\"100003349\" data-ratio=\"0.5142503097893433\" data-s=\"300,640\" data-src=\"https://mmbiz.qpic.cn/mmbiz_png/Bgib4dvhgGgyHxSpSpRm6GdvOTvIxn3ibG0UChT13zR0uZKwnLfSAic3gdFyMAc98N7iaGkhuMsXJjEdgTUIADnXhpicFIfceQhwEBGfLZdpoZXk/640?wx_fmt=png&amp;from=appmsg\" data-type=\"png\" data-w=\"807\" type=\"block\"/></section><p style=\"text-align: justify;text-indent: 2em;\"><span style=\"color: rgb(63, 63, 63);font-size: 10pt;\"><font face=\"等线(中文正文)\"><span leaf=\"\"><span style=\"font-size: 17px;font-weight: bold;\" textstyle=\"\">比如前一天美股科技大跌，老登</span></span></font></span><span style=\"color: rgb(63, 63, 63);font-size: 10pt;\"><font face=\"等线(中文正文)\"><span leaf=\"\"><span style=\"font-size: 17px;font-weight: bold;\" textstyle=\"\">反弹</span></span></font></span><span style=\"color: rgb(63, 63, 63);font-size: 10pt;\"><font face=\"等线(中文正文)\"><span leaf=\"\"><span style=\"font-size: 17px;font-weight: bold;\" textstyle=\"\">，</span></span></font></span><span style=\"color: rgb(63, 63, 63);font-size: 10pt;\"><font face=\"等线(中文正文)\"><span leaf=\"\"><span style=\"font-size: 17px;font-weight: bold;\" textstyle=\"\">但</span></span></font></span><span style=\"color: rgb(63, 63, 63);font-size: 10pt;\"><font face=\"等线(中文正文)\"><span leaf=\"\"><span style=\"font-size: 17px;font-weight: bold;\" textstyle=\"\">第二天</span></span></font><span leaf=\"\"><span style=\"font-size: 17px;font-weight: bold;\" textstyle=\"\">A股</span></span></span><span style=\"color: rgb(63, 63, 63);font-size: 10pt;\"><font face=\"等线(中文正文)\"><span leaf=\"\"><span style=\"font-size: 17px;font-weight: bold;\" textstyle=\"\">科技</span></span></font></span><span style=\"color: rgb(63, 63, 63);font-size: 10pt;\"><font face=\"等线(中文正文)\"><span leaf=\"\"><span style=\"font-size: 17px;font-weight: bold;\" textstyle=\"\">连个相应的低开都没有</span></span></font></span><span style=\"color: rgb(63, 63, 63);font-size: 10pt;\"><font face=\"等线(中文正文)\"><span leaf=\"\"><span style=\"font-size: 17px;font-weight: bold;\" textstyle=\"\">。</span></span></font></span></p><p style=\"text-align: justify;text-indent: 2em;\"><span style=\"color: rgb(63, 63, 63);font-size: 10pt;\"><font face=\"等线(中文正文)\"><span leaf=\"\"><span style=\"font-size: 17px;font-weight: bold;\" textstyle=\"\">老登也能看出散户在割肉。</span></span></font></span></p><p style=\"text-align: justify;text-indent: 2em;\"><span style=\"color: rgb(63, 63, 63);font-size: 10pt;\"><font face=\"等线(中文正文)\"><span leaf=\"\"><span style=\"font-size: 17px;font-weight: bold;\" textstyle=\"\">第一</span></span></font></span><span style=\"color: rgb(63, 63, 63);font-size: 10pt;\"><font face=\"等线(中文正文)\"><span leaf=\"\"><span style=\"font-size: 17px;font-weight: bold;\" textstyle=\"\">基金经理集体道歉。集体道歉并不是因为他们觉得他们做错了，是因为他们的基金被大规模赎回</span></span></font></span><span style=\"color: rgb(63, 63, 63);font-size: 10pt;\"><font face=\"等线(中文正文)\"><span leaf=\"\"><span style=\"font-size: 17px;font-weight: bold;\" textstyle=\"\">，</span></span></font></span><span style=\"color: rgb(63, 63, 63);font-size: 10pt;\"><font face=\"等线(中文正文)\"><span leaf=\"\"><span style=\"font-size: 17px;font-weight: bold;\" textstyle=\"\">扛不住了</span></span></font></span><span style=\"color: rgb(63, 63, 63);font-size: 10pt;\"><font face=\"等线(中文正文)\"><span leaf=\"\"><span style=\"font-size: 17px;font-weight: bold;\" textstyle=\"\">。</span></span></font></span></p><p style=\"text-align: justify;text-indent: 2em;\"><span style=\"color: rgb(63, 63, 63);font-size: 10pt;\"><font face=\"等线(中文正文)\"><span leaf=\"\"><span style=\"font-size: 17px;font-weight: bold;\" textstyle=\"\">第二是红利加速下跌，</span></span></font></span><span style=\"color: rgb(63, 63, 63);font-size: 10pt;\"><font face=\"等线(中文正文)\"><span leaf=\"\"><span style=\"font-size: 17px;font-weight: bold;\" textstyle=\"\">固收</span></span></font><font face=\"等线(中文正文)\"><span leaf=\"\"><span style=\"font-size: 17px;font-weight: bold;\" textstyle=\"\">+这种稳健的</span></span></font></span><span style=\"color: rgb(63, 63, 63);font-size: 10pt;\"><font face=\"等线(中文正文)\"><span leaf=\"\"><span style=\"font-size: 17px;font-weight: bold;\" textstyle=\"\">产品</span></span></font></span><span style=\"color: rgb(63, 63, 63);font-size: 10pt;\"><font face=\"等线(中文正文)\"><span leaf=\"\"><span style=\"font-size: 17px;font-weight: bold;\" textstyle=\"\">也在被赎回</span></span></font></span><span style=\"color: rgb(63, 63, 63);font-size: 10pt;\"><font face=\"等线(中文正文)\"><span leaf=\"\"><span style=\"font-size: 17px;font-weight: bold;\" textstyle=\"\">。</span></span></font></span></p><p style=\"text-align: justify;text-indent: 2em;\"><span style=\"color: rgb(63, 63, 63);font-size: 10pt;\"><font face=\"等线(中文正文)\"><span leaf=\"\"><span style=\"font-size: 17px;font-weight: bold;\" textstyle=\"\">种种迹象</span></span></font></span><span style=\"color: rgb(63, 63, 63);font-size: 10pt;\"><font face=\"等线(中文正文)\"><span leaf=\"\"><span style=\"font-size: 17px;font-weight: bold;\" textstyle=\"\">表明，</span></span></font></span><span style=\"color: rgb(63, 63, 63);font-size: 10pt;\"><font face=\"等线(中文正文)\"><span leaf=\"\"><span style=\"font-size: 17px;font-weight: bold;\" textstyle=\"\">这波</span></span></font></span><span style=\"color: rgb(63, 63, 63);font-size: 10pt;\"><font face=\"等线(中文正文)\"><span leaf=\"\"><span style=\"font-size: 17px;font-weight: bold;\" textstyle=\"\">科技的</span></span></font></span><span style=\"color: rgb(63, 63, 63);font-size: 10pt;\"><font face=\"等线(中文正文)\"><span leaf=\"\"><span style=\"font-size: 17px;font-weight: bold;\" textstyle=\"\">拉升其实是有歧义的，</span></span></font></span><span style=\"color: rgb(63, 63, 63);font-size: 10pt;\"><font face=\"等线(中文正文)\"><span leaf=\"\"><span style=\"font-size: 17px;font-weight: bold;\" textstyle=\"\">散户追涨迹象明显，</span></span></font></span><span style=\"color: rgb(63, 63, 63);font-size: 10pt;\"><font face=\"等线(中文正文)\"><span leaf=\"\"><span style=\"font-size: 17px;font-weight: bold;\" textstyle=\"\">大家最好小心一点。</span></span></font></span></p><p data-pm-slice=\"0 0 []\" style='-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;clear: both;min-height: 1em;color: rgba(0, 0, 0, 0.9);font-size: 17px;font-style: normal;font-variant-ligatures: n